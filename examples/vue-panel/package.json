{
  "name": "ext-example-vue-panel",
  "version": "0.1.0",
  "description": "Example: the Hello world panel as a Vue component.",
  "type": "module",
  "exports": "./dist/index.js",
  "license": "MIT",
  "muclient": {
    "id": "example-vue-panel",
    "api": "^1.14",
    "source": "src/index.ts",
    "displayName": "Example: Vue panel",
    "description": "The Hello world panel written as a Vue component mounted with mu.panels.vue, with a per-session count in mu.storage.session.",
    "categories": [
      "developer"
    ],
    "contributes": {
      "panels": [
        {
          "id": "example-vue-panel",
          "title": "Vue panel"
        }
      ],
      "commands": [
        {
          "id": "example-vue-panel.open",
          "title": "Vue panel: open"
        }
      ],
      "storage": {
        "session": [
          "count"
        ]
      }
    },
    "capabilities": [
      "send-commands"
    ]
  }
}
